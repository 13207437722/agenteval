# 复制为 .env 并填写（.env 已在 .gitignore 中，不会被提交）

# Judge 模型：任意 OpenAI 兼容接口
JUDGE_API_KEY=sk-xxx
JUDGE_MODEL=gpt-4o
# 非 OpenAI 官方接口时填写，例如：
#   DeepSeek:   https://api.deepseek.com
#   通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_BASE_URL=
# 接口不支持 response_format=json_object 时改为 0
JUDGE_JSON_MODE=1
